# ── Neon Postgres ─────────────────────────────────────────
# Obtenir depuis : https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT ────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
JWT_SECRET=change-me-in-production

# ── App (front) ───────────────────────────────────────────
# Laisser vide pour utiliser les données mockées en développement
# Mettre l'URL de prod pour activer l'API réelle
VITE_API_URL=

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:5173


postgresql://neondb_owner:npg_wguGbm2qDtC8@ep-morning-rain-awk3rl5j.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Module Capture de Leads ───────────────────────────────
# Clé AES-256 pour chiffrer les cookies Facebook (32 bytes hex = 64 chars)
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_ENCRYPTION_KEY=

# JWT de service pour le bot (signer avec JWT_SECRET, rôle commercial, expiration 1 an)
BOT_JWT=

# URL de base de l'API kiosq (ex: https://kiosq.vercel.app)
KIOSQ_API_URL=

# Token Apify pour le scraping Facebook
APIFY_TOKEN=

# Clé API Google Gemini
GEMINI_API_KEY=

# Seuil de score de confiance Gemini (posts ignorés si score < seuil)
SCORE_SEUIL=0.7
