# JWT de service kiosq (rôle commercial) — générer avec: npm run generate-jwt
BOT_JWT=

# URL de base de l'API kiosq
# Local (npm run api:dev à la racine) : http://localhost:3001
# Production : https://votre-app.vercel.app
KIOSQ_API_URL=http://localhost:3001

# Token d'API Apify pour le scraping Facebook
APIFY_TOKEN=

# ID de l'actor Apify (optionnel, défaut: apify~facebook-groups-scraper)
# APIFY_ACTOR_ID=apify~facebook-groups-scraper

# Clé API Google Gemini
GEMINI_API_KEY=

# Seuil de score en dessous duquel un post est ignoré (défaut: 0.7)
SCORE_SEUIL=0.7
