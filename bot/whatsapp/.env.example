# ==============================================================================
# bot/whatsapp/.env.example
# Copier vers bot/.env et renseigner les valeurs.
#
# Variables REQUISES : le bot refuse de démarrer si l'une d'elles est absente.
# Variables OPTIONNELLES : valeur par défaut appliquée si non renseignée.
# ==============================================================================

# ------------------------------------------------------------------------------
# BOT_JWT
# Token JWT signé utilisé par le bot pour s'authentifier auprès de l'API Kiosq.
# Générer avec : npm run generate-jwt  (depuis le répertoire bot/)
# Le token a une durée de validité limitée ; renouveler avant expiration.
# ------------------------------------------------------------------------------
BOT_JWT=your-bot-jwt-token

# ------------------------------------------------------------------------------
# KIOSQ_API_URL
# URL de base de l'API Kiosq, sans slash final.
# Local : http://localhost:3001
# Prod  : https://kiosq.vercel.app
# ------------------------------------------------------------------------------
KIOSQ_API_URL=https://your-kiosq-api-url.example.com

# ------------------------------------------------------------------------------
# GEMINI_API_KEY
# Clé API Google Gemini pour le module NLU (interprétation des messages clients).
# Obtenir : https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ==============================================================================
# VARIABLES OPTIONNELLES
# ==============================================================================

# Port d'écoute du serveur HTTP de santé (défaut : 3002)
WHATSAPP_BOT_PORT=3002

# Score NLU minimum (0-1) en dessous duquel le bot demande une reformulation (défaut : 0.6)
NLU_SCORE_SEUIL=0.6

# Chemin vers l'exécutable Chromium — défini automatiquement dans Docker.
# Ne pas définir en dev macOS (le bot utilise Chrome.app par défaut).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
